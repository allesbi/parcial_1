<?xml version="1.0" encoding="UTF-8"?>
<Configuration name="Log4j2Config" status="warn" strict="true">

    <Properties>
        <Property name="app_log_root">logs</Property>
        <Property name="log_pattern">%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n</Property>
        <Property name="log">Fight</Property>
    </Properties>

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${log_pattern}"/>
        </Console>

        <RollingFile append="true" fileName="${app_log_root}/${log}.log" filePattern="${app_log_root}/${log}-%d{yyyy-MM-dd}-%i.log.gz" name="FileLogger">
            <PatternLayout pattern="${log_pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>

        <Loggers>
            <Root level="info">
                <AppenderRef ref="Console"/>
                <AppenderRef ref="FileLogger"/>
            </Root>

            <Logger additivity="false" level="debug" name="com.example">
                <AppenderRef ref="Console"/>
                <AppenderRef ref="FileLogger"/>
            </Logger>
        </Loggers>

    </Appenders>

</Configuration>